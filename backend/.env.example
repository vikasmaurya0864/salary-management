# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed — only this example file is.

# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ---- Logging ----
# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Secrets ----
# Shared key every client (UI) must send as the `X-API-Key` header on
# every /api/* request. Generate a strong random value for real environments.
API_KEY=replace-with-a-long-random-string

# Signs/verifies user JWTs. Generate a strong random value (32+ chars) for
# real environments, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
# Short-lived access JWT lifetime in seconds (900 = 15 minutes).
JWT_ACCESS_TOKEN_TTL_SECONDS=900
# Opaque refresh token lifetime in days (hashed row in refresh_tokens).
REFRESH_TOKEN_TTL_DAYS=7

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salary_management
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
# Set to "true" only for providers that require SSL (most managed cloud DBs).
DB_SSL=false

# ---- Bootstrap admin account ----
# Created once by `npm run db:seed` on a fresh database so you have a way
# to log in and start creating HR/Employee users. Change the password after
# first login in any real environment.
ADMIN_EMAIL=admin@salary-management.local
ADMIN_PASSWORD=replace-with-a-strong-password

# ---- Email (attendance reminder / auto-absence cron jobs) ----
# All optional — leave blank for local dev. If unset, the mailer logs a
# warning and skips sending instead of erroring (attendance still gets
# auto-marked absent either way).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="Salary Management <no-reply@salary-management.local>"
# Shown in the 8am attendance reminder email ("contact HR team …").
HR_CONTACT_EMAIL=hr@info.in

# ---- Redis (GET-response cache) ----
# Caches list/get-by-id responses (users, roles, permissions, attendance,
# corrections). Any create/update/delete invalidates the relevant cache
# right away, so the NEXT GET call is guaranteed to recompute fresh data.
# If Redis is down/unreachable, GET endpoints just bypass the cache and hit
# Postgres directly instead of failing.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Safety-net TTL (seconds) a cached response expires after even without an
# explicit write invalidating it first.
CACHE_TTL_SECONDS=300

# ---- Cron jobs ----
# Timezone the 8am reminder / 7pm auto-absence jobs run in. Keep as UTC
# unless you also change the UTC-based "today"/day-of-week logic in
# src/utils/date.ts to match.
CRON_TIMEZONE=UTC
# Set to "false" to disable both attendance cron jobs (e.g. in tests, or
# when running multiple instances where only one should schedule them).
ENABLE_CRON_JOBS=true

# Add more secrets here as the app needs them, following the same pattern:
# declare them as required (no default) in src/config/env.ts.
