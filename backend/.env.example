# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed — only this example file is.

# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ---- Logging ----
# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Secrets ----
# Shared key every client (UI) must send as the `X-API-Key` header on
# every /api/* request. Generate a strong random value for real environments.
API_KEY=replace-with-a-long-random-string

# Signs/verifies user JWTs. Generate a strong random value (32+ chars) for
# real environments, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salary_management
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
# Set to "true" only for providers that require SSL (most managed cloud DBs).
DB_SSL=false

# ---- Bootstrap admin account ----
# Created once by `npm run db:seed` on a fresh database so you have a way
# to log in and start creating HR/Employee users. Change the password after
# first login in any real environment.
ADMIN_EMAIL=admin@salary-management.local
ADMIN_PASSWORD=replace-with-a-strong-password

# Add more secrets here as the app needs them, following the same pattern:
# declare them as required (no default) in src/config/env.ts.
