{
  "name": "backend",
  "version": "1.0.0",
  "description": "Salary Management Portal API server",
  "main": "dist/index.js",
  "scripts": {
    "predev": "kill-port 4000",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "kill-port 4000",
    "start": "node dist/index.js",
    "stop": "kill-port 4000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/sensible": "^6.0.4",
    "bcrypt": "^6.0.0",
    "close-with-grace": "^2.5.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "kill-port": "^2.0.1",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
